C_CDAC_N_2 n2n VSSP 0.7f
C_CDAC_N_3 n1n VSSP 0.6f
C_CDAC_N_4 n0n VSSP 0.5f
CMAIN_N_3 n3n n2n 4f
CMAIN_N_2 n2n n1n 2f
CMAIN_N_1 n1n n0n 1f
RLEAK_N_3 n3n VSSP 50Meg
RLEAK_N_2 n2n VSSP 50Meg
RLEAK_N_1 n1n VSSP 50Meg
RLEAK_N_0 n0n VSSP 50Meg


