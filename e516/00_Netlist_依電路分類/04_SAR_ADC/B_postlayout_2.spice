* 4-bit SAR ADC fully flattened post-layout netlist
.option post=2 nomod
.temp 27
.param Lmin=0.18u
.model nch nmos level=1 vto=0.45 kp=220u lambda=0.05
.model pch pmos level=1 vto=-0.45 kp=85u lambda=0.06
VDD VDD 0 1.8
VSS VSS 0 0
VCM VCM 0 0.9
VREFP VREFP 0 1.2
VREFN VREFN 0 0.6
VINP VINP 0 0.9
VINN VINN 0 0.9
VCLK CLK 0 PULSE(0 1.8 0 50p 50p 5n 10n)
VSTART START 0 PULSE(0 1.8 2n 50p 50p 20n 40n)

* package / routing parasitics
RPKG_VDD VDD VDDP 0.18
RPKG_VSS VSS VSSP 0.16
CPKG_VDD VDDP VSSP 120f
CPKG_VSS VSSP 0 30f
RPKG_CLK CLK CLK1 0.28
RPKG_START START START1 0.24
RPKG_INP VINP VINP1 0.35
RPKG_INN VINN VINN1 0.35
RPKG_VREFP VREFP VREFP1 0.22
RPKG_VREFN VREFN VREFN1 0.22
CPKG_CLK CLK1 VSSP 4f
CPKG_START START1 VSSP 2f
CPKG_INP VINP1 VSSP 10f
CPKG_INN VINN1 VSSP 10f
CPKG_VREFP VREFP1 VSSP 8f
CPKG_VREFN VREFN1 VSSP 8f
RINP VINP1 SA_INP 0.35
RINN VINN1 SA_INN 0.35
CCOMP COMP VSSP 3f
CCOMPB COMPB VSSP 3f

Mn_SA1 net1 CLK VSSP VSSP nch W=6u L=Lmin
Mn_SA2 net2 CLK VSSP VSSP nch W=6u L=Lmin
Mn_SA3 COMP INN net1 VSSP nch W=4u L=Lmin
Mn_SA4 COMPB INP net2 VSSP nch W=4u L=Lmin
Mn_SA5 net1 INP tail VSSP nch W=3u L=Lmin
Mn_SA6 net2 INN tail VSSP nch W=3u L=Lmin
Mn_SA7 tail CLK VSSP VSSP nch W=8u L=Lmin
Mp_SA1 COMP CLK VDDP VDDP pch W=4u L=Lmin
Mp_SA2 COMPB CLK VDDP VDDP pch W=4u L=Lmin
Mp_SA3 net1 RST VDDP VDDP pch W=2u L=Lmin
Mp_SA4 net2 RST VDDP VDDP pch W=2u L=Lmin
Mp_SA5 RST CLK VDDP VDDP pch W=2u L=Lmin
R_SA1 COMP VSSP 2Meg
R_SA2 COMPB VSSP 2Meg
C_SA1 COMP VSSP 12f
C_SA2 COMPB VSSP 12f

RCDAC_P_0 SA_INP SA_INP1 0.20
RCDAC_P_1 SA_INP1 n3p 0.08
C_CDAC_P_0 SA_INP1 VSSP 1.0f
RCDAC_P_2 n3p n2p 0.06
RCDAC_P_3 n2p n1p 0.05
RCDAC_P_4 n1p n0p 0.04
C_CDAC_P_1 n3p VSSP 0.8f
C_CDAC_P_2 n2p VSSP 0.7f
C_CDAC_P_3 n1p VSSP 0.6f
C_CDAC_P_4 n0p VSSP 0.5f
CMAIN_P_3 n3p n2p 4f
CMAIN_P_2 n2p n1p 2f
CMAIN_P_1 n1p n0p 1f
RLEAK_P_3 n3p VSSP 50Meg
RLEAK_P_2 n2p VSSP 50Meg
RLEAK_P_1 n1p VSSP 50Meg
RLEAK_P_0 n0p VSSP 50Meg
RCDAC_N_0 SA_INN SA_INN1 0.20
RCDAC_N_1 SA_INN1 n3n 0.08
C_CDAC_N_0 SA_INN1 VSSP 1.0f
RCDAC_N_2 n3n n2n 0.06
