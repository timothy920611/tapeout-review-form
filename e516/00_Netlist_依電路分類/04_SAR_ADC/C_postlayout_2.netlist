* ============================================================
* SECTION 7:  CDAC switch cells  –  fully inlined
*             Pattern: CDAC_SW_MSB for D9/D8/D7, _MID D6..D3, _LSB D2..D0
*             Each cell expands to 7 INV/AND2/TG + their transistors
* ============================================================

* ---- Helper macro: inline AND2 = NAND2 + INV ----
* (transistors labeled _na2_ for nand2 stage, _inv_ for inverter)

* --- CDAC_SW_MSB for D9 (positive side, sw_p9) ---
M_swp9_i0n  _n0800_ D9      VSS  VSS N_18_MM W=1u L=0.18u M=1  $INV SAMPLE->sl0
M_swp9_i0p  _n0800_ D9      VDD  VDD P_18_MM W=3u L=0.18u M=1
M_swp9_i1n  _n0801_ net_d9b VSS  VSS N_18_MM W=1u L=0.18u M=1  $INV D->sl1
M_swp9_i1p  _n0801_ net_d9b VDD  VDD P_18_MM W=3u L=0.18u M=1
* AND2 for sel_refp: NAND2(_sl1, _sl0) + INV
M_swp9_na2_P0 _n0802_ _n0801_ VDD VDD P_18_MM W=3u L=0.18u M=1
M_swp9_na2_P1 _n0802_ _n0800_ VDD VDD P_18_MM W=3u L=0.18u M=1
M_swp9_na2_N0 _n0802_ _n0801_ _n0803_ VSS N_18_MM W=2u L=0.18u M=1
M_swp9_na2_N1 _n0803_ _n0800_ VSS     VSS N_18_MM W=2u L=0.18u M=1
M_swp9_i2n    _n0804_ _n0802_ VSS VSS N_18_MM W=1u L=0.18u M=1  $INV-> sl2 (REFP_EN)
M_swp9_i2p    _n0804_ _n0802_ VDD VDD P_18_MM W=3u L=0.18u M=1
* AND2 for sel_refn
M_swp9_na3_P0 _n0805_ D9     VDD VDD P_18_MM W=3u L=0.18u M=1
M_swp9_na3_P1 _n0805_ _n0800_ VDD VDD P_18_MM W=3u L=0.18u M=1
M_swp9_na3_N0 _n0805_ D9     _n0806_ VSS N_18_MM W=2u L=0.18u M=1
M_swp9_na3_N1 _n0806_ _n0800_ VSS    VSS N_18_MM W=2u L=0.18u M=1
M_swp9_i3n    _n0807_ _n0805_ VSS VSS N_18_MM W=1u L=0.18u M=1  $REFN_EN
M_swp9_i3p    _n0807_ _n0805_ VDD VDD P_18_MM W=3u L=0.18u M=1
* TG_X4 for SAMPLE path
M_swp9_tgs_n  net_sample _n0800_ sw_p9 VSS N_18_MM W=4u L=0.18u M=4
M_swp9_tgs_p  net_sample _n0804_ sw_p9 VDD P_18_MM W=12u L=0.18u M=4
* TG_X4 for REFP path
M_swp9_tgp_n  REFP _n0804_ sw_p9 VSS N_18_MM W=4u L=0.18u M=4
M_swp9_tgp_p  REFP _n0802_ sw_p9 VDD P_18_MM W=12u L=0.18u M=4
* TG_X4 for REFN path
M_swp9_tgn_n  REFN _n0807_ sw_p9 VSS N_18_MM W=4u L=0.18u M=4
M_swp9_tgn_p  REFN _n0805_ sw_p9 VDD P_18_MM W=12u L=0.18u M=4
* Parasitics for sw_p9 bottom plate node
